#!/usr/bin/env pwsh
$ErrorActionPreference = 'Stop'
$repoRoot = Split-Path -Parent $PSScriptRoot
$worklog = Join-Path $repoRoot 'e_energymind/WORKLOG.md'
$projectlog = Join-Path $repoRoot 'e_energymind/PROJECT_LOG.md'
$diff = git diff --name-only --cached
$staged = @($diff -split "`n" | Where-Object { $_ -ne '' })
if ($staged.Count -eq 0) { exit 0 }
$logTouched = $staged -contains 'e_energymind/WORKLOG.md' -and $staged -contains 'e_energymind/PROJECT_LOG.md'
if (-not $logTouched) {
  Write-Host "Pre-push check: aggiorna WORKLOG.md e PROJECT_LOG.md prima del push." -ForegroundColor Yellow
  exit 1
}
exit 0
