#!/bin/sh
# Block push if WORKLOG.md and PROJECT_LOG.md are not staged
set -e
STAGED=$(git diff --name-only --cached)
if [ -z "$STAGED" ]; then
  exit 0
fi
HAS_WORKLOG=$(printf "%s\n" "$STAGED" | grep -F -c "e_energymind/WORKLOG.md" || true)
HAS_PROJECT=$(printf "%s\n" "$STAGED" | grep -F -c "e_energymind/PROJECT_LOG.md" || true)
if [ "$HAS_WORKLOG" -eq 0 ] || [ "$HAS_PROJECT" -eq 0 ]; then
  echo "Pre-push check: aggiorna WORKLOG.md e PROJECT_LOG.md prima del push." >&2
  exit 1
fi
exit 0
